# Copy to .env and fill in. Never commit .env.

# --- Core ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://angel:angel@localhost:5432/angel
PUBLIC_BASE_URL=http://localhost:3000
# Shared secret the streamer sends on /internal/* requests
INTERNAL_SHARED_SECRET=change-me
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Time zone for every rule the donor sees. Timestamps are stored in UTC.
TZ_DISPLAY=Europe/Riga

# --- Paysera Checkout (Classic), from M3 ---
PAYSERA_PROJECT_ID=
PAYSERA_SIGN_PASSWORD=
# 1 = test payments. The project must have "Allow Test Payments" enabled.
PAYSERA_TEST_MODE=1

# --- ElevenLabs, from M4 ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Must be a Latvian-capable model (eleven_v3, eleven_v4, eleven_v4_turbo).
ELEVENLABS_MODEL_ID=eleven_v4

# --- LLM (moderation and Latvian grammar only), from M4 ---
LLM_API_KEY=
LLM_MODEL=

# --- Email, from M6 ---
EMAIL_API_KEY=
EMAIL_FROM=

# --- Object storage (R2 or S3): songs, greeting audio, jingle ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Bucket prefix of the active music library. Swapping libraries = change this
# and re-import metadata.
STORAGE_LIBRARY_PREFIX=dev/

# --- Stream, from M5 ---
# HLS playlist URL shown to the player
STREAM_PUBLIC_URL=http://localhost:8080/stream.m3u8
